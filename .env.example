# Coach Copilot Environment Configuration
# Copy this file to .env and fill in your values

# Environment: "development" or "production"
ENVIRONMENT=development

# LLM Provider: "ollama" (local) or "gemini" (API)
LLM_PROVIDER=ollama

GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

CHROMA_PERSIST_DIRECTORY=./data/chroma_db

GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-default-spreadsheet-id

ATHLETE_PINS={"Boldi": "1234", "test": "2345", "test2": "3456"}

YOUTUBE_CHANNEL_URL=https://www.youtube.com/@boldinagy

# Coach Copilot Environment Configuration
# Copy this file to .env and fill in your values

# "ollama" or "gemini"
LLM_PROVIDER=ollama

# Gemini (optional - comment out if using Ollama only)
# GEMINI_API_KEY=your-api-key
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FAST_MODEL=gemini-2.0-flash-lite

# Ollama CPU-friendly models with tool calling
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_FAST_MODEL=qwen2.5:0.5b

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

GOOGLE_SHEETS_CREDENTIALS_PATH=secrets/credentials.json

ATHLETE_PINS={"Boldi": "1234", "test": "2345", "test2": "3456"}

YOUTUBE_CHANNEL_URL=https://www.youtube.com/@boldinagy

# YouTube Data API (optional - for video search and metadata)
# Get API key from https://console.cloud.google.com/
# Enable "YouTube Data API v3" in your project
# YOUTUBE_API_KEY=your-youtube-api-key
# YOUTUBE_CHANNEL_ID=UCxxxxxxxxxx  # Find in channel URL or about page

# LangFuse Monitoring (optional - for observability)
# Sign up at https://cloud.langfuse.com to get keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com


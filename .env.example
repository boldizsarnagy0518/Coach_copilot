# Coach Copilot Environment Configuration
# Copy this file to .env and fill in your values

# Options: "ollama" (local, for development) or "gemini" (API, for production)
LLM_PROVIDER=ollama

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Options: "ollama" or "gemini"
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=coach_knowledge

GOOGLE_SHEETS_CREDENTIALS_PATH=path/to/google_sheets_credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id-here

YOUTUBE_CHANNEL_URL=https://www.youtube.com/@boldinagy

# Set to "development" or "production"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

UI_HOST=127.0.0.1
UI_PORT=8080
UI_RELOAD=true
